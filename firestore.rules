rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Пользователь видит и редактирует ТОЛЬКО свой документ
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Валидация: документ должен содержать поле data
      allow write: if request.resource.data.keys().hasAll(['data']);
    }

    // Все остальные коллекции закрыты полностью
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
